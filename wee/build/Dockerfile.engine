FROM python:3.9.2

RUN apt-get update && \
    apt-get install -y tesseract-ocr tesseract-ocr-tha libglib2.0-0 libsm6 libxext6 libxrender-dev

    
WORKDIR /
COPY requirements.txt /requirements.txt
RUN pip install -r /requirements.txt
COPY app /app
EXPOSE 8000

CMD ["uvicorn", "app.main:app", "--port", "8000", "--host", "0.0.0.0","--root-path","/wee/api/v1"]

